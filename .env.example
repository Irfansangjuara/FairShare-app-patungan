# Localhost memakai PostgreSQL dari docker-compose.yml / Homebrew postgres.
DATABASE_URL=postgresql://localhost:5432/fairshare

# URL kanonis dipakai untuk membentuk tautan berbagi, canonical tag, sitemap,
# dan robots.txt. Set ke domain produksi saat deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Wajib: nilai ACAK minimal 32 karakter. Dipakai untuk menandatangani state
# OAuth dan token session-sync. Tidak ada nilai fallback di kode, dan nilai
# contoh yang pernah ikut ter-commit ke repository akan DITOLAK (fails closed).
# Buat nilai baru, contoh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=ganti-dengan-nilai-acak-minimal-32-karakter

# ---------------------------------------------------------------------------
# Bootstrap administrator.
# Akun admin dibuat / di-rotate dari nilai ini saat aplikasi start.
# Tidak ada kredensial admin yang ditanam di kode.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@fairshare.copilotmarketing.id
ADMIN_PASSWORD=ChangeMe-LocalDev-Only-32charsMin

# ---------------------------------------------------------------------------
# Token AI Agent resmi (opsional).
# Nilai acak minimal 32 karakter. Bila kosong, tidak ada token agent resmi.
# FAIRSHARE_AGENT_EMAIL harus menunjuk ke akun yang SUDAH ada di database.
# ---------------------------------------------------------------------------
# FAIRSHARE_AGENT_TOKEN=
# FAIRSHARE_AGENT_EMAIL=

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
